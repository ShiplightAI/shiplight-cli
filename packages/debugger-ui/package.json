{
  "name": "debugger-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --config vite.debugger.config.ts",
    "pretypecheck": "tsx ../../scripts/build-workspace-deps.mts",
    "typecheck": "tsc --noEmit",
    "check:i18n-keys": "node scripts/check-i18n-keys.js",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src",
    "pretest": "tsx ../../scripts/build-workspace-deps.mts",
    "test": "node --test --experimental-test-module-mocks --experimental-test-coverage --import tsx --test-reporter spec 'src/**/*.test.ts'",
    "pretest:unit": "tsx ../../scripts/build-workspace-deps.mts",
    "test:unit": "node --test --experimental-test-module-mocks --experimental-test-coverage --import tsx --test-reporter spec 'src/**/*.test.ts'",
    "pretest:watch": "tsx ../../scripts/build-workspace-deps.mts",
    "test:watch": "node --test --experimental-test-module-mocks --watch --import tsx 'src/**/*.test.ts'",
    "pretest:coverage": "tsx ../../scripts/build-workspace-deps.mts",
    "test:coverage": "node --test --experimental-test-module-mocks --experimental-test-coverage --import tsx --test-reporter spec --test-reporter lcov --test-reporter-destination=lcov.info 'src/**/*.test.ts'",
    "build:debugger-ui": "vite build --config vite.debugger.config.ts && vite build --config vite.debugger-shell.config.ts"
  },
  "dependencies": {
    "@babel/standalone": "^7.27.0",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mantine/core": "^8.2.1",
    "@mantine/hooks": "^8.2.1",
    "@mantine/modals": "^8.2.1",
    "@mantine/notifications": "^8.2.1",
    "@monaco-editor/react": "^4.6.0",
    "@tabler/icons-react": "^3.29.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "mitt": "^3.0.1",
    "next": "15.5.18",
    "next-intl": "^4.8.3",
    "react": "^18",
    "react-dom": "^18",
    "shiplight-types": "workspace:*",
    "swr": "^2.3.3",
    "uuid": "^11.1.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@svgr/webpack": "^8.1.0",
    "@types/babel__standalone": "^7.1.9",
    "@types/node": "^24.0.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9",
    "eslint-config-next": "^15",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "postcss": "^8",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vite": "^6.0.0"
  },
  "description": "Shiplight debugger UI \u2014 vite-built SPA embedded in the shiplightai CLI",
  "license": "MIT"
}
