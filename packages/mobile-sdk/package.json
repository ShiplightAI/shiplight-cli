{
  "name": "mobile-sdk",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "pretypecheck": "tsx ../../scripts/build-workspace-deps.mts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit",
    "pretest:unit": "tsx ../../scripts/build-workspace-deps.mts",
    "test:unit": "node --test \"src/**/*.test.mjs\""
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.28",
    "@ai-sdk/google-vertex": "^5.0.35",
    "@google/genai": "^1.34.0",
    "@yume-chan/adb": "^0.0.23",
    "@yume-chan/adb-scrcpy": "^0.0.23",
    "@yume-chan/adb-server-node-tcp": "^0.0.23",
    "@yume-chan/scrcpy": "^0.0.23",
    "@yume-chan/stream-extra": "^0.0.23",
    "ai": "^7.0.42",
    "appium-adb": "^11.0.0",
    "axios": "^1.15.0",
    "dotenv": "^16.4.5",
    "expect-webdriverio": "^5.0.3",
    "nanoid": "^5.0.9",
    "openai": "^4.104.0",
    "sharp": "^0.35.3",
    "shiplight-types": "workspace:*",
    "socket.io": "^4.6.1",
    "webdriverio": "^9.4.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "license": "MIT"
}
