{
  "name": "@shiplightai/sdk",
  "version": "0.1.11",
  "type": "module",
  "description": "Shiplight SDK with pluggable custom actions",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShiplightAI/shiplight-cli.git",
    "directory": "packages/sdk-public"
  },
  "scripts": {
    "build": "tsup && pnpm build:dts",
    "build:dts": "node scripts/build-declarations.mjs",
    "clean": "rm -rf dist .tmp",
    "dev": "tsup --watch --onSuccess \"pnpm build:dts\"",
    "prepublishOnly": "node scripts/assert-package-artifacts.mjs",
    "pretest:unit": "tsx ../../scripts/build-workspace-deps.mts",
    "test:unit": "node --experimental-test-module-mocks --test --import tsx 'src/**/__tests__/*.test.ts'",
    "pretypecheck": "tsx ../../scripts/build-workspace-deps.mts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.24",
    "@ai-sdk/google": "^4.0.28",
    "@ai-sdk/google-vertex": "^5.0.35",
    "@ai-sdk/openai": "^4.0.24",
    "@ai-sdk/provider": "^4.0.4",
    "@babel/parser": "^7.28.5",
    "@google/genai": "^1.34.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.42",
    "axios": "^1.15.0",
    "html-to-text": "^9.0.5",
    "openai": "^6.25.0",
    "otplib": "^13.4.0",
    "p-retry": "^6.2.1",
    "sharp": "^0.35.3",
    "uuid": "^11.0.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.12",
    "playwright": "1.60.0",
    "sdk-core": "workspace:*",
    "shiplight-types": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "5.5.4"
  },
  "peerDependencies": {
    "playwright": "^1.60.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "playwright",
    "automation",
    "ai",
    "browser",
    "testing",
    "shiplight",
    "custom-actions"
  ],
  "author": "Shiplight",
  "license": "MIT",
  "homepage": "https://github.com/ShiplightAI/shiplight-cli#readme",
  "bugs": {
    "url": "https://github.com/ShiplightAI/shiplight-cli/issues"
  }
}
