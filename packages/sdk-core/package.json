{
  "name": "sdk-core",
  "version": "0.1.0",
  "type": "module",
  "description": "General-purpose SDK for browser automation with AI capabilities",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./axtree-shared": {
      "types": "./src/dom/axtree-shared.ts",
      "import": "./src/dom/axtree-shared.ts",
      "default": "./src/dom/axtree-shared.ts"
    },
    "./cloud-routing": {
      "types": "./src/utils/resolveApiBase.ts",
      "import": "./src/utils/resolveApiBase.ts",
      "default": "./src/utils/resolveApiBase.ts"
    },
    "./run-usage-summary": {
      "types": "./src/agent/runUsageSummary.ts",
      "import": "./src/agent/runUsageSummary.ts",
      "default": "./src/agent/runUsageSummary.ts"
    },
    "./dom-tree": {
      "import": "./src/dom/dom-tree/dist/index.js",
      "default": "./src/dom/dom-tree/dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm build:dom-tree && pnpm typecheck && tsup",
    "build:dom-tree": "tsx src/dom/dom-tree/build.ts",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "pretypecheck": "tsx ../../scripts/build-workspace-deps.mts",
    "typecheck": "tsc --noEmit",
    "pretest": "tsx ../../scripts/build-workspace-deps.mts",
    "test": "playwright test --config=tests/playwright.config.ts",
    "pretest:unit": "tsx ../../scripts/build-workspace-deps.mts",
    "test:unit": "node --experimental-test-module-mocks --test --import tsx 'src/**/*.test.ts'",
    "pretest:browser": "tsx ../../scripts/build-workspace-deps.mts",
    "test:browser": "playwright test --config=tests/playwright.config.ts tests/specs/engine-fixture.spec.ts",
    "pretest:browser:all": "tsx ../../scripts/build-workspace-deps.mts",
    "test:browser:all": "playwright test --config=tests/playwright.config.ts",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.24",
    "@ai-sdk/google": "^4.0.28",
    "@ai-sdk/google-vertex": "^5.0.35",
    "@ai-sdk/openai": "^4.0.24",
    "@ai-sdk/provider": "^4.0.4",
    "@babel/parser": "^7.28.5",
    "@google/genai": "^1.34.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.42",
    "html-to-text": "^9.0.5",
    "openai": "^6.25.0",
    "otplib": "^13.4.0",
    "sharp": "^0.35.3",
    "uuid": "^11.0.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^24.0.0",
    "dotenv": "^16.4.0",
    "esbuild-plugin-raw": "^0.3.0",
    "eslint": "^9.39.1",
    "playwright": "1.60.0",
    "shiplight-types": "workspace:*",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "5.5.4",
    "typescript-eslint": "^8.48.0"
  },
  "peerDependencies": {
    "playwright": "^1.60.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shiplight/shiplight-sdk.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "playwright",
    "automation",
    "ai",
    "browser",
    "testing",
    "shiplight"
  ],
  "author": "Shiplight",
  "license": "MIT"
}
