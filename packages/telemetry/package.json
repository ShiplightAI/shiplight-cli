{
  "name": "shiplight-telemetry",
  "version": "0.1.0",
  "description": "Zero-dependency anonymous usage telemetry shared by the Shiplight CLI and MCP server",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "pnpm typecheck && rimraf dist && tsup",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "tsx --test 'src/**/*.test.ts'",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "shiplight",
    "telemetry"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
