{
  "name": "shiplight-cli",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build --filter=shiplightai --filter=@shiplightai/mcp --filter=@shiplightai/sdk",
    "build:all": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "lint": "turbo run lint --filter=shiplightai... --filter=@shiplightai/mcp... --filter=@shiplightai/sdk... --filter=debugger-ui...",
    "test": "turbo run test --filter=shiplightai... --filter=@shiplightai/mcp... --filter=@shiplightai/sdk... --filter=debugger-ui...",
    "test:unit": "turbo run test:unit --filter=shiplightai... --filter=@shiplightai/mcp... --filter=@shiplightai/sdk... --filter=debugger-ui...",
    "typecheck": "turbo run typecheck --filter=shiplightai... --filter=@shiplightai/mcp... --filter=@shiplightai/sdk... --filter=debugger-ui..."
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "turbo": "2.6.0",
    "typescript": "5.5.4",
    "yaml": "2.8.3"
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "@smithy/types": "^4.5.0",
      "@aws-sdk/client-s3": "^3.937.0",
      "@aws-sdk/s3-request-presigner": "^3.937.0",
      "sharp": "0.35.3",
      "axios": "^1.16.0",
      "protobufjs": "^7.6.4",
      "form-data@4": "^4.0.6",
      "fast-xml-parser": "^5.9.3",
      "shell-quote": "^1.8.4",
      "basic-ftp": "^5.3.1",
      "handlebars": "^4.7.9",
      "@babel/plugin-transform-modules-systemjs": "^7.29.4",
      "@grpc/grpc-js": "^1.14.4",
      "@hono/node-server": "^1.19.10",
      "@xmldom/xmldom": "^0.8.13",
      "fast-uri@3": "^3.1.2",
      "flatted": "^3.4.2",
      "hono": "^4.12.25",
      "immutable": "^5.1.5",
      "jws@3": "^3.2.3",
      "linkifyjs": "^4.3.2",
      "minimatch@3": "^3.1.5",
      "path-to-regexp@0.1": "^0.1.13",
      "picomatch@2": "^2.3.2",
      "preact": "^10.26.10",
      "qs": "^6.5.3",
      "rollup": "^4.59.0",
      "socket.io-parser": "^4.2.6",
      "svgo": "^3.3.3",
      "systeminformation": "^5.31.6",
      "tmp": "^0.2.6",
      "undici@7": "^7.28.0",
      "undici@6": "^6.27.0",
      "glob@10": "^10.5.0",
      "glob@11": "^11.1.0",
      "minimatch@5": "^5.1.8",
      "form-data@2": "^2.5.6",
      "ws@8": "^8.21.0",
      "body-parser@1": "^1.20.3",
      "jws@4": "^4.0.1",
      "path-to-regexp@8": "^8.4.2",
      "picomatch@4": "^4.0.4",
      "tar@7": "^7.5.11",
      "@modelcontextprotocol/sdk@1": "^1.29.0",
      "vite@6": "^6.4.3",
      "lodash": "^4.18.0"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "electron",
      "esbuild",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.43",
    "@google/generative-ai": "^0.24.1",
    "ai": "^6.0.116"
  }
}
